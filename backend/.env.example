# Postgres connection used by Prisma
DATABASE_URL="postgresql://codesentinel:codesentinel@localhost:5432/codesentinel?schema=public"

# LLM provider for the explanation layer.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use for explanations
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Port the NestJS API listens on
PORT=4000
